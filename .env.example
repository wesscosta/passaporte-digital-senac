# Somente desenvolvimento. Não armazene segredos reais no repositório.
DJANGO_DEBUG=1
DB_ENGINE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# IPs ou redes (CIDR) dos proxies reversos de confiança, separados por vírgula.
# Vazio usa só REMOTE_ADDR. Exemplo fictício: DJANGO_TRUSTED_PROXIES=192.0.2.10,2001:db8::10
DJANGO_TRUSTED_PROXIES=
# Produção exige segredo e credenciais próprios, HTTPS e revisão de configuração.
